# Configuración Modbus
MODBUS_PORT = getattr(const, "modbus_port", "/dev/ttyS7")
MODBUS_BAUD = getattr(const, "modbus_baudrate", 9600)
MODBUS_TIMEOUT = getattr(const, "modbus_timeout", 1)
MODBUS_PARITY = getattr(const, "modbus_parity", "N")
MODBUS_STOPBITS = getattr(const, "modbus_stopbits", 1)
MODBUS_BYTESIZE = getattr(const, "modbus_bytesize", 8)
WORD_SWAP_INPUTS = getattr(const, "word_swap_inputs", False)
WORD_SWAP_HOLDING = getattr(const, "word_swap_holding", False)
ANALOG_INPUTS_IN_UA = getattr(const, "raw_ai_microamps", True)
TEMP_SUPPLY_OFFSET = float(getattr(const, "temp_supply_offset", 0.0))
TEMP_RETURN_OFFSET = float(getattr(const, "temp_return_offset", 0.0))
HUMIDITY_OFFSET = float(getattr(const, "humidity_offset", 0.0))
USE_HW = getattr(const, "use_modbus_hw", False)
WRITE_ENABLED = getattr(const, "enable_modbus_write", False)
AO_FULL_SCALE_MV = getattr(const, "analog_output_full_scale_mv", 10000.0)
SOLENOID_LEAD_SECONDS = getattr(const, "solenoid_lead_seconds", 5.0)
SOLENOID_OFF_DELAY_SECONDS = getattr(const, "solenoid_off_delay_seconds", 5.0)

# Logger simple para procesos hijos (solo stdout)
def _log(msg: str) -> None:
    try:
        ts = time.strftime("%Y-%m-%d %H:%M:%S")
        print(f"[{ts}] {msg}", flush=True)
    except Exception:
        pass


# Evita que los procesos hijos reaccionen a Ctrl+C (solo el main debería hacerlo)
def _ignore_sigint() -> None:
    try:
        signal.signal(signal.SIGINT, signal.SIG_IGN)
    except Exception:
        pass
    try:
        if hasattr(sys.stdout, "reconfigure"):
            sys.stdout.reconfigure(line_buffering=True)
    except Exception:
        pass


def _convert_ai(name: str, raw_ma: float) -> float:
    """Convierte corriente 4-20 mA a ingeniería según el sensor."""
    if raw_ma is None:
        return float("nan")
    span = max(raw_ma - 4.0, 0.0)
    if name == "temperatura_suministro":
        return max(0.0, min(100.0, span / 16.0 * 100.0 + TEMP_SUPPLY_OFFSET))
    if name == "temperatura_retorno":
        return max(0.0, min(50.0, span / 16.0 * 50.0 + TEMP_RETURN_OFFSET))
    if name == "humedad":
        return max(0.0, min(100.0, span / 16.0 * 100.0 + TEMP_SUPPLY_OFFSET))
    return raw_ma


def _regs_to_float32(r0: int, r1: int, word_swap: bool) -> float:
    hi, lo = (r1, r0) if word_swap else (r0, r1)
    u32 = ((hi & 0xFFFF) << 16) | (lo & 0xFFFF)
    return struct.unpack(">f", struct.pack(">I", u32))[0]


def _float_to_words(value: float, word_swap: bool) -> List[int]:
    u32 = struct.unpack(">I", struct.pack(">f", float(value)))[0]
    hi = (u32 >> 16) & 0xFFFF
    lo = u32 & 0xFFFF
    return [lo, hi] if word_swap else [hi, lo]


def _group_by_slave_and_type(regs: List[Dict[str, Any]]) -> Dict[Tuple[int, str], List[Dict[str, Any]]]:
    out: Dict[Tuple[int, str], List[Dict[str, Any]]] = {}
    for item in regs:
        key = (int(item.get("slave_id", 1)), str(item.get("type", "")))
        out.setdefault(key, []).append(item)
    return out


def _compute_block(items: List[Dict[str, Any]], one_based: bool) -> Tuple[int, int]:
    starts = []
    ends = []
    for it in items:
        addr = int(it.get("address", 0))
        words = int(it.get("words", 1))
        start0 = addr - 1 if one_based else addr
        starts.append(start0)
        ends.append(start0 + words)
    start = min(starts)
    end = max(ends)
    return start, end - start


_serial = None
_READ_SKIP_UNTIL: Dict[int, float] = {}
_READ_FAILS: Dict[int, int] = {}
FORCED_INPUTS: Dict[str, Any] = {
    "temperatura_suministro": 12.0,
    "temperatura_retorno": 28.0,
    "humedad": 55.0,
    "frecuencia_vfd": 30.0,
    "retroalimentacion_valvula": 4.0,
    "estatus_ventilador": 1,
    "estatus_prefiltro": 0,
    "estatus_filtro": 0,
    "detector_humo": 0,
    "alarma_vfd": 0,
    "alarma_termica": 0,
    "estatus_luz_ultravioleta": 1,
    "estatus_calentador": 1,
}
_READ_FAILS: Dict[int, int] = {}
_READ_SKIP_UNTIL: Dict[int, float] = {}
_serial_lock = threading.Lock()
_CURRENT_TIPICO = getattr(tipicos, "DEFAULT_TIPICO", 1) if tipicos else 1

if USE_HW:
    if not (serial and rtu):
        _log("[modbus] umodbus o pyserial no disponibles, deshabilitando Modbus HW")
        USE_HW = False
    else:
        try:
            _serial = serial.Serial(
                port=MODBUS_PORT,
                baudrate=MODBUS_BAUD,
                timeout=MODBUS_TIMEOUT,
                parity=MODBUS_PARITY,
                stopbits=MODBUS_STOPBITS,
                bytesize=MODBUS_BYTESIZE,
            )
            if not _serial.is_open:
                _serial.open()
            _log(f"[modbus] Puerto {MODBUS_PORT} abierto para lectura")
        except SerialException as exc:
            _log(f"[modbus] Error abriendo puerto {MODBUS_PORT}: {exc}")
            USE_HW = False
        except Exception as exc:
            _log(f"[modbus] Error inicializando Modbus: {exc}")
            USE_HW = False

_last_heater_raw = None
_last_coils: Dict[str, bool] = {}
_seq_lead_ts = {"comp1": None, "comp2": None}
_seq_off_ts = {"comp1": None, "comp2": None}
_seq_prev_outputs: Dict[str, bool] = {}


def _aplicar_secuencia_compresor(idx: int, desired_on: bool, outputs: Dict[str, Any], now_ts: float) -> Dict[str, Any]:
    """Secuencia por compresor: solenoide antes de compresor y cola de apagado."""
    eff = dict(outputs)
    comp_key = f"comp{idx}"
    sol_key = f"solenoid{idx}"

    prev_comp_on = bool(_seq_prev_outputs.get(comp_key))
    prev_sol_on = bool(_seq_prev_outputs.get(sol_key))

    if desired_on:
        _seq_off_ts[comp_key] = None
        if _seq_lead_ts.get(comp_key) is None or not prev_comp_on:
            _seq_lead_ts[comp_key] = now_ts
        eff[sol_key] = True
        eff[comp_key] = prev_comp_on or prev_sol_on or (now_ts - _seq_lead_ts[comp_key]) >= SOLENOID_LEAD_SECONDS
    else:
        _seq_lead_ts[comp_key] = None
        eff[comp_key] = False
        if prev_comp_on or prev_sol_on:
            if _seq_off_ts.get(comp_key) is None:
                _seq_off_ts[comp_key] = now_ts
            eff[sol_key] = (now_ts - _seq_off_ts[comp_key]) < SOLENOID_OFF_DELAY_SECONDS
            if not eff[sol_key]:
                _seq_off_ts[comp_key] = None
        else:
            eff[sol_key] = False
            _seq_off_ts[comp_key] = None

    # Si nunca llegó a encender el compresor y se canceló la orden durante el lead, cancelar solenoide sin cola.
    if (not desired_on) and (not prev_comp_on) and prev_sol_on and not eff.get(comp_key, False):
        eff[sol_key] = False
        _seq_off_ts[comp_key] = None

    _seq_prev_outputs[comp_key] = eff.get(comp_key, False)
    _seq_prev_outputs[sol_key] = eff.get(sol_key, False)
    return eff


def compresor_1_ON(outputs: Dict[str, Any], now_ts: float) -> Dict[str, Any]:
    return _aplicar_secuencia_compresor(1, True, outputs, now_ts)


def compresor_1_OFF(outputs: Dict[str, Any], now_ts: float) -> Dict[str, Any]:
    return _aplicar_secuencia_compresor(1, False, outputs, now_ts)


def compresor_2_ON(outputs: Dict[str, Any], now_ts: float) -> Dict[str, Any]:
    return _aplicar_secuencia_compresor(2, True, outputs, now_ts)


def compresor_2_OFF(outputs: Dict[str, Any], now_ts: float) -> Dict[str, Any]:
    return _aplicar_secuencia_compresor(2, False, outputs, now_ts)


def aplicar_secuencias(outputs: Dict[str, Any], now_ts: float) -> Dict[str, Any]:
    """Aplica la secuencia de encendido/apagado a ambos compresores según el comando deseado."""
    eff = dict(outputs)
    eff = compresor_1_ON(eff, now_ts) if eff.get("comp1") else compresor_1_OFF(eff, now_ts)
    eff = compresor_2_ON(eff, now_ts) if eff.get("comp2") else compresor_2_OFF(eff, now_ts)
    return eff



def _refresh_runtime_modbus_settings(shared_state) -> None:
    global ANALOG_INPUTS_IN_UA, TEMP_SUPPLY_OFFSET, TEMP_RETURN_OFFSET, HUMIDITY_OFFSET
    try:
        settings = shared_state.get("settings") or {}
    except Exception:
        settings = {}
    ANALOG_INPUTS_IN_UA = bool(settings.get("raw_ai_microamps", ANALOG_INPUTS_IN_UA))
    TEMP_SUPPLY_OFFSET = float(settings.get("temp_supply_offset", TEMP_SUPPLY_OFFSET))
    TEMP_RETURN_OFFSET = float(settings.get("temp_return_offset", TEMP_RETURN_OFFSET))
    HUMIDITY_OFFSET = float(settings.get("humidity_offset", HUMIDITY_OFFSET))


def read_registers_snapshot() -> Dict[str, Any]:
    """Lectura de snapshot, usando HW si está disponible."""
    if USE_HW and _serial and regist and rtu:
        return _read_modbus_inputs()
    _log("[modbus] Snapshot no disponible: HW deshabilitado")
    return {}


def _update_values_from_block(
    items: List[Dict[str, Any]],
    block_start: int,
    block_words: List[int],
    *,
    one_based: bool,
    word_swap: bool,
    analog_is_uA: bool,
    apply_ai_mapping: bool,
) -> None:
    for it in items:
        addr = int(it.get("address", 0))
        words = int(it.get("words", 1))
        scale = float(it.get("scale", 1.0))
        start0 = addr - 1 if one_based else addr
        offset = start0 - block_start

        if offset < 0 or offset + words > len(block_words):
            it["value"] = None
            continue

        if words == 1:
            raw = block_words[offset]
            it["raw"] = raw
            it["value"] = raw * scale
        elif words == 2:
            r0 = block_words[offset]
            r1 = block_words[offset + 1]
            f = _regs_to_float32(r0, r1, word_swap=word_swap)
            raw_ma = f * (1.0 / 1000.0) if analog_is_uA else f
            it["raw"] = (r0, r1, f, raw_ma)
            it["value"] = _convert_ai(it.get("name", ""), raw_ma) if apply_ai_mapping else raw_ma * scale
        else:
            it["raw"] = None
            it["value"] = float("nan")


def _allowed_reg_names_for_tipico(tipico_id: int) -> set:
    """
    Devuelve el conjunto de nombres de registro que se deben leer para el típico activo.
    Usa los required_sensors/actuators declarados en tipicos.py.
    """
    if not tipicos:
        return set()
    cfg = tipicos.get_tipico_config(tipico_id)
    required = set(cfg.get("required_sensors", set())) | set(cfg.get("required_actuators", set()))
    # Siempre incluimos supply/return para monitoreo básico si no están
    required |= {"temperatura_suministro", "temperatura_retorno"}
    return required


def _read_modbus_inputs(stop_event=None, shared_state=None) -> Dict[str, Any]:
    snapshot: Dict[str, Any] = {}
    if not (USE_HW and _serial and regist and rtu):
        # Simulación: devolver FORCED_INPUTS (mezclado con overrides) y reflejarlo en registros para el monitor.
        forced = dict(FORCED_INPUTS)
        if shared_state:
            forced.update(dict(shared_state.get("forced_inputs", {})))
        tipico_id = int(shared_state.get("tipico", getattr(tipicos, "DEFAULT_TIPICO", 1))) if shared_state else getattr(tipicos, "DEFAULT_TIPICO", 1)
        if regist:
            for k, v in forced.items():
                try:
                    regist.update_value(k, float(v), tipico_id)
                except Exception:
                    pass
        return forced

    tipico_id = int(shared_state.get("tipico", getattr(tipicos, "DEFAULT_TIPICO", 1))) if shared_state else getattr(tipicos, "DEFAULT_TIPICO", 1)
    regs_filtered = regist.get_registers_for_tipico(tipico_id) if regist else []

    grouped = _group_by_slave_and_type(regs_filtered)
    now_ts = time.time()

    for (slave_id, typ), items in grouped.items():
        if stop_event is not None and stop_event.is_set():
            break
        if now_ts < _READ_SKIP_UNTIL.get(slave_id, 0):
            continue
        try:
            if typ == "input":
                if slave_id == 4:
                    # Leer AI del esclavo 4 uno por uno para evitar rangos no soportados
                    for it in sorted(items, key=lambda x: int(x.get("address", 0))):
                        addr = int(it.get("address", 0))
                        words_qty = int(it.get("words", 1))
                        # Intento 1: asumir addresses como ya 0-based
                        start = addr
                        success = False
                        for candidate in (start, addr - 1):
                            if candidate < 0:
                                continue
                            try:
                                req = rtu.read_input_registers(
                                    slave_id=slave_id, starting_address=candidate, quantity=words_qty
                                )
                                with _serial_lock:
                                    words = rtu.send_message(req, _serial)
                                _update_values_from_block(
                                    [it],
                                    block_start=candidate,
                                    block_words=words,
                                    one_based=True,
                                    word_swap=WORD_SWAP_INPUTS,
                                    analog_is_uA=ANALOG_INPUTS_IN_UA,
                                    apply_ai_mapping=True,
                                )
                                success = True
                                break
                            except Exception:
                                continue
                        if not success:
                            it["value"] = None
                            it["raw"] = None
                else:
                    start, qty = _compute_block(items, one_based=True)
                    req = rtu.read_input_registers(slave_id=slave_id, starting_address=start, quantity=qty)
                    with _serial_lock:
                        words = rtu.send_message(req, _serial)
                    _update_values_from_block(
                        items,
                        block_start=start,
                        block_words=words,
                        one_based=True,
                        word_swap=WORD_SWAP_INPUTS,
                        analog_is_uA=ANALOG_INPUTS_IN_UA,
                        apply_ai_mapping=True,
                    )
            elif typ == "holding":
                start, qty = _compute_block(items, one_based=False)
                req = rtu.read_holding_registers(slave_id=slave_id, starting_address=start, quantity=qty)
                with _serial_lock:
                    words = rtu.send_message(req, _serial)
                _update_values_from_block(
                    items,
                    block_start=start,
                    block_words=words,
                    one_based=False,
                    word_swap=WORD_SWAP_HOLDING,
                    analog_is_uA=False,
                    apply_ai_mapping=False,
                )
            elif typ == "discrete":
                start = min(int(it.get("address", 0)) for it in items)
                end = max(int(it.get("address", 0)) for it in items)
                qty = end - start + 1
                req = rtu.read_discrete_inputs(slave_id=slave_id, starting_address=start, quantity=qty)
                with _serial_lock:
                    bits = rtu.send_message(req, _serial)
                for it in items:
                    offset = int(it.get("address", 0)) - start
                    it["raw"] = int(bits[offset])
                    it["value"] = float(bits[offset]) * float(it.get("scale", 1.0))
            elif typ == "coil":
                start = min(int(it.get("address", 0)) for it in items)
                end = max(int(it.get("address", 0)) for it in items)
                qty = end - start + 1
                req = rtu.read_coils(slave_id=slave_id, starting_address=start, quantity=qty)
                with _serial_lock:
                    bits = rtu.send_message(req, _serial)
                for it in items:
                    offset = int(it.get("address", 0)) - start
                    it["raw"] = int(bits[offset])
                    it["value"] = float(bits[offset]) * float(it.get("scale", 1.0))
            else:
                continue
        except Exception as exc:  # pragma: no cover - runtime
            _log(f"[modbus] Error leyendo slave {slave_id} tipo {typ}: {exc}")
            _READ_FAILS[slave_id] = _READ_FAILS.get(slave_id, 0) + 1
            if _READ_FAILS[slave_id] >= 3:
                _READ_SKIP_UNTIL[slave_id] = time.time() + 10.0
                _READ_FAILS[slave_id] = 0
            if "not an allowable address" in str(exc).lower():
                _READ_SKIP_UNTIL[slave_id] = time.time() + 10.0
            continue

        for it in items:
            name = it.get("name") or f"{typ}_{it.get('address') }"
            val = it.get("value")
            if val is None:
                continue
            snapshot[name] = val
            try:
                regist.update_value(name, float(val), tipico_id)
            except Exception:
                pass

            _READ_FAILS[slave_id] = 0  # éxito: reset contador

    return snapshot


def _publish_registers_to_shared(shared_state, tipico_id: int) -> None:
    """Copia los registros (con valores mutados) al shared_state para que el monitor los vea en otro proceso."""
    if not (shared_state and regist):
        return
    try:
        regs = regist.get_registers_for_tipico(tipico_id) or []
        shared_state["registers"] = [dict(item) for item in regs]
    except Exception:
        pass


def read_inputs(stop_event=None, shared_state=None) -> Dict[str, Any]:
    if USE_HW and _serial and regist and rtu:
        return _read_modbus_inputs(stop_event, shared_state)
    _log("[modbus] Lectura ignorada: HW deshabilitado")
    return {}


def write_outputs(outputs: Dict[str, Any]) -> None:
    if USE_HW and WRITE_ENABLED and _serial and regist and rtu:
        # usa tipico actual si shared_state global existe
        try:
            from var import tipicos as _t
            tid = _CURRENT_TIPICO
        except Exception:
            tid = 1
        _write_coils_hw(outputs, tid)
        _write_tipico_aos_hw(outputs, tid)
        _write_heater_hw(outputs, tid)
        return
    _log("[modbus] Escritura ignorada: HW deshabilitado o WRITE_ENABLED=False")


def _update_registers_from_state(sensors: Dict[str, Any], actuators: Dict[str, Any]) -> None:
    if not regist:
        return
    tid = _CURRENT_TIPICO if "_CURRENT_TIPICO" in globals() else getattr(tipicos, "DEFAULT_TIPICO", 1)
    mapping = {
        # Canonical
        "temperatura_suministro": sensors.get("temperatura_suministro", sensors.get("supply_temp", 0.0)),
        "temperatura_retorno": sensors.get("temperatura_retorno", sensors.get("return_temp", 0.0)),
        "retroalimentacion_valvula": sensors.get("retroalimentacion_valvula", 0.0),
        "frecuencia_vfd": sensors.get("frecuencia_vfd", 0.0),
        "presion_filtro_hepa": sensors.get("presion_filtro_hepa", 0.0),
        "presion_ducto_suministro": sensors.get("presion_ducto_suministro", 0.0),
        "co2_retorno": sensors.get("co2_retorno", 0.0),
        "posicion_compuerta_oa": sensors.get("posicion_compuerta_oa", 0.0),
        "estatus_ventilador": sensors.get("estatus_ventilador", sensors.get("fan_status", 0)),
        "estatus_prefiltro": sensors.get("estatus_prefiltro", 0),
        "estatus_filtro": sensors.get("estatus_filtro", sensors.get("filter_status", 0)),
        "detector_humo": sensors.get("detector_humo", 0),
        "alarma_vfd": sensors.get("alarma_vfd", 0),
        "alarma_termica": sensors.get("alarma_termica", 0),
        "posicion_automatico": sensors.get("posicion_automatico", 1),
        "posicion_manual": sensors.get("posicion_manual", 0),
        "estatus_luz_ultravioleta": sensors.get("estatus_luz_ultravioleta", 0),
        "estatus_calentador": sensors.get("estatus_calentador", sensors.get("heater_status", 0)),
        "comando_contactor": 1 if actuators.get("comando_contactor") else 0,
        "comando_vfd": 1 if actuators.get("comando_vfd") else 0,
        "comando_luz_ultravioleta": 1 if actuators.get("comando_luz_ultravioleta") else 0,
        "control_frec_vfd": actuators.get("control_frec_vfd", 0.0),
        "control_valvula": actuators.get("control_valvula", 0.0),
        "control_compuerta_aire_exterior": actuators.get("control_compuerta_aire_exterior", 0.0),
        # Legacy mirrors
        "status_ventilador": sensors.get("fan_status", 0),
        "status_compresor_1": sensors.get("comp1_status", 0),
        "status_compresor_2": sensors.get("comp2_status", 0),
        "status_filtro": sensors.get("filter_status", 0),
        "status_calentador": sensors.get("heater_status", 0),
        "humedad": sensors.get("humidity", 0.0),
        "comando_ventilador": 1 if actuators.get("fan") else 0,
        "comando_compresor_1": 1 if actuators.get("comp1") else 0,
        "comando_compresor_2": 1 if actuators.get("comp2") else 0,
        "regulacion_calentador": actuators.get("heater", 0.0),
    }
    for name, value in mapping.items():
        try:
            regist.update_value(name, float(value), tid)
        except Exception:
            pass


def _apply_snapshot_to_sensors(snapshot: Dict[str, Any], sensors: Dict[str, Any]) -> None:
    sensor_map = {
        # Canonical
        "temperatura_suministro": "temperatura_suministro",
        "temperatura_retorno": "temperatura_retorno",
        "retroalimentacion_valvula": "retroalimentacion_valvula",
        "frecuencia_vfd": "frecuencia_vfd",
        "presion_filtro_hepa": "presion_filtro_hepa",
        "presion_ducto_suministro": "presion_ducto_suministro",
        "co2_retorno": "co2_retorno",
        "posicion_compuerta_oa": "posicion_compuerta_oa",
        "estatus_ventilador": "estatus_ventilador",
        "estatus_prefiltro": "estatus_prefiltro",
        "estatus_filtro": "estatus_filtro",
        "detector_humo": "detector_humo",
        "alarma_vfd": "alarma_vfd",
        "alarma_termica": "alarma_termica",
        "posicion_automatico": "posicion_automatico",
        "posicion_manual": "posicion_manual",
        "estatus_luz_ultravioleta": "estatus_luz_ultravioleta",
        "estatus_calentador": "estatus_calentador",
        # Legacy
        "humedad": "humidity",
        "status_ventilador": "fan_status",
        "status_filtro": "filter_status",
        "status_compresor_1": "comp1_status",
        "status_compresor_2": "comp2_status",
        "status_calentador": "heater_status",
    }
    for reg_name, sensor_key in sensor_map.items():
        if reg_name in snapshot:
            sensors[sensor_key] = snapshot.get(reg_name, 0)

    # Espejos entre nombres canónicos y legados
    sensors["supply_temp"] = sensors.get("temperatura_suministro", sensors.get("supply_temp", 0.0))
    sensors["return_temp"] = sensors.get("temperatura_retorno", sensors.get("return_temp", 0.0))
    sensors["fan_status"] = sensors.get("estatus_ventilador", sensors.get("fan_status", 0))


def _apply_snapshot_to_actuators(snapshot: Dict[str, Any], actuators: Dict[str, Any]) -> None:
    """
    Refleja en los actuadores los valores leídos desde campo (coils/holding).
    Así ingesta reporta lo que realmente está en la periferia.
    """
    coil_map = {
        "comando_ventilador": "fan",
        "comando_compresor_1": "comp1",
        "comando_compresor_2": "comp2",
        "comando_solenoide_1": "solenoid1",
        "comando_solenoide_2": "solenoid2",
        "comando_contactor": "comando_contactor",
        "comando_vfd": "comando_vfd",
        "comando_luz_ultravioleta": "comando_luz_ultravioleta",
    }
    for reg_name, act_key in coil_map.items():
        if reg_name in snapshot:
            try:
                actuators[act_key] = bool(snapshot.get(reg_name, 0))
            except Exception:
                pass

    if "regulacion_calentador" in snapshot:
        raw = snapshot.get("regulacion_calentador", 0.0)
        try:
            raw = float(raw)
            # Escalamos a % si parece venir en mV (p.ej. 0-10000)
            heater_pct = raw / AO_FULL_SCALE_MV * 100.0 if AO_FULL_SCALE_MV else raw
            actuators["heater"] = heater_pct
        except Exception:
            actuators["heater"] = raw



def _write_ao_hw(reg_name: str, value_0_10v: float, tipico_id: int) -> None:
    if not (USE_HW and WRITE_ENABLED and _serial and regist and rtu):
        return
    reg = regist.get_reg_by_name_for_tipico(tipico_id).get(reg_name) if regist else None
    if not reg:
        return
    volts = max(0.0, min(10.0, float(value_0_10v)))
    words = _float_to_words(volts, word_swap=WORD_SWAP_HOLDING)
    try:
        if int(reg.get("words", 1)) == 1:
            req = rtu.write_single_register(slave_id=reg.get("slave_id", 1), address=reg["address"], value=int(volts))
        else:
            req = rtu.write_multiple_registers(
                slave_id=reg.get("slave_id", 1),
                starting_address=reg["address"],
                values=words,
            )
        with _serial_lock:
            rtu.send_message(req, _serial)
        regist.update_value(reg_name, volts)
    except Exception:
        pass


def _write_tipico_aos_hw(outputs: Dict[str, Any], tipico_id: int) -> None:
    _write_ao_hw("control_valvula", outputs.get("control_valvula", 0.0), tipico_id)
    _write_ao_hw("control_frec_vfd", outputs.get("control_frec_vfd", 0.0), tipico_id)
    _write_ao_hw("control_compuerta_aire_exterior", outputs.get("control_compuerta_aire_exterior", 0.0), tipico_id)


def _write_heater_hw(outputs: Dict[str, Any], tipico_id: int) -> None:
    reg = regist.get_reg_by_name_for_tipico(tipico_id).get("regulacion_calentador") if regist else None
    if not reg:
        return
    try:
        pct = max(0.0, min(100.0, float(outputs.get("heater", 0.0))))
        raw_mv = pct / 100.0 * AO_FULL_SCALE_MV
        global _last_heater_raw
        raw_mv_int = int(raw_mv)
        if _last_heater_raw is not None and raw_mv_int == _last_heater_raw:
            return  # mismo valor que el último enviado; no reescribir
        words = _float_to_words(raw_mv, WORD_SWAP_HOLDING)
        #_log(
        #    f"[modbus][write] holding regulacion_calentador slave={reg.get('slave_id', 1)} "
        #    f"addr={reg['address']} pct={pct:.1f}% raw_mv={raw_mv:.1f} words={words}"
        #)
        if int(reg.get("words", 1)) == 1:
            req = rtu.write_single_register(
                slave_id=reg.get("slave_id", 1),
                address=reg["address"],
                value=int(raw_mv),
            )
        else:
            req = rtu.write_multiple_registers(
                slave_id=reg.get("slave_id", 1),
                starting_address=reg["address"],
                values=words,
            )
        with _serial_lock:
            rtu.send_message(req, _serial)
        _last_heater_raw = raw_mv_int
        regist.update_value("regulacion_calentador", raw_mv)
    except Exception:
        pass


def _write_coils_hw(outputs: Dict[str, Any], tipico_id: int) -> None:
    """
    Escribe coils de mando (fan/compresores/solenoides) solo cuando cambia el valor.
    """
    coil_map = {
        "comando_ventilador": "fan",
        "comando_compresor_1": "comp1",
        "comando_compresor_2": "comp2",
        "comando_solenoide_1": "solenoid1",
        "comando_solenoide_2": "solenoid2",
        "comando_contactor": "comando_contactor",
        "comando_vfd": "comando_vfd",
        "comando_luz_ultravioleta": "comando_luz_ultravioleta",
    }
    for reg_name, out_key in coil_map.items():
        try:
            reg = regist.get_reg_by_name_for_tipico(tipico_id).get(reg_name) if regist else None
            if not reg:
                continue
            desired = bool(outputs.get(out_key, False))
            if _last_coils.get(reg_name) == desired:
                continue  # sin cambios
            _log(
                f"[modbus][write] coil {reg_name} slave={reg.get('slave_id', 1)} "
                f"addr={reg['address']} value={'ON' if desired else 'OFF'}"
            )
            req = rtu.write_single_coil(
                slave_id=reg.get("slave_id", 1),
                address=reg["address"],
                value=desired,
            )
            with _serial_lock:
                rtu.send_message(req, _serial)
            _last_coils[reg_name] = desired
            regist.update_value(reg_name, 1 if desired else 0)
        except Exception:
            continue


def modbus_loop(shared_state, stop_event, poll_seconds: float = 3.0) -> None:
    _ignore_sigint()
    time.sleep(1)
    if USE_HW:
        _log(f"[modbus] Modo hardware activo en puerto {MODBUS_PORT}")
    else:
        _log(f"[modbus] Simulación activa (sin acceso a puerto). Puerto configurado: {MODBUS_PORT}")
    _log("[modbus] Loop iniciado, esperando lecturas...")

    # Primer snapshot: solo para leer sensores antes de forzar todo a OFF
    try:
        first_snapshot = read_inputs(stop_event, shared_state)
    except Exception as exc:
        first_snapshot = {}
        _log(f"[modbus] Error en lectura inicial: {exc}")

    sensors_first = shared_state.get("sensors")
    actuators_first = shared_state.get("actuators")
    if first_snapshot:
        if sensors_first is not None:
            _apply_snapshot_to_sensors(first_snapshot, sensors_first)
        if actuators_first is not None:
            _apply_snapshot_to_actuators(first_snapshot, actuators_first)
        try:
            _CURRENT_TIPICO = int(shared_state.get("tipico", getattr(tipicos, "DEFAULT_TIPICO", 1)))
        except Exception:
            _CURRENT_TIPICO = getattr(tipicos, "DEFAULT_TIPICO", 1)
        _publish_registers_to_shared(shared_state, _CURRENT_TIPICO)
    else:
        _log("[modbus] Snapshot inicial vacío, se enviarán cambios aunque el estado previo sea desconocido")

    # Forzar primera escritura en OFF para todo
    desired_off = dict(actuators_first or {})
    # Solo apagamos compresores/heater; ventilador queda como estaba (solenoides se derivan en la secuencia)
    desired_off["comp1"] = False
    desired_off["comp2"] = False
    desired_off["heater"] = 0.0
    _last_coils.clear()
    _seq_prev_outputs.clear()
    if actuators_first is not None:
        _seq_prev_outputs.update(
            {
                "comp1": bool(actuators_first.get("comp1", False)),
                "comp2": bool(actuators_first.get("comp2", False)),
                "solenoid1": bool(actuators_first.get("solenoid1", False)),
                "solenoid2": bool(actuators_first.get("solenoid2", False)),
            }
        )
    _seq_lead_ts.update({"comp1": None, "comp2": None})
    _seq_off_ts.update({"comp1": None, "comp2": None})

    hw_ready_init = USE_HW and _serial and regist and rtu
    if hw_ready_init and actuators_first is not None:
        off_outputs = aplicar_secuencias(dict(desired_off), time.time())
        write_outputs(off_outputs)
        for k, v in off_outputs.items():
            actuators_first[k] = v

    warned_no_hw = False

    while not stop_event.is_set():
        try:
            _refresh_runtime_modbus_settings(shared_state)
            try:
                _CURRENT_TIPICO = int(shared_state.get("tipico", getattr(tipicos, "DEFAULT_TIPICO", 1)))
            except Exception:
                _CURRENT_TIPICO = getattr(tipicos, "DEFAULT_TIPICO", 1)
            hw_ready = USE_HW and _serial and regist and rtu
            if not hw_ready:
                if not warned_no_hw:
                    _log("[modbus] HW deshabilitado; no se leerán/escribirán registros")
                    warned_no_hw = True
                time.sleep(poll_seconds)
                continue

            actuators = shared_state.get("actuators")
            if actuators is not None:
                # Aplica la secuencia por compresor (ON/OFF) antes de escribir a campo.
                raw_outputs = dict(actuators)
                current_outputs = aplicar_secuencias(raw_outputs, time.time())
                write_outputs(current_outputs)
                for k, v in current_outputs.items():
                    actuators[k] = v

            try:
                snapshot = read_inputs(stop_event, shared_state)
            except Exception as exc:
                snapshot = {}
                _log(f"[modbus] Error en read_inputs: {exc}")

            try:
                shared_state["last_modbus_ok"] = bool(snapshot)
            except Exception:
                pass

            sensors = shared_state.get("sensors")
            if sensors is not None:
                # Aplicar overrides forzados de sensores antes de escribir en shared_state
                forced_inputs = shared_state.get("forced_inputs") or {}
                if forced_inputs:
                    snapshot.update(dict(forced_inputs))
                _apply_snapshot_to_sensors(snapshot, sensors)

            try:
                _update_registers_from_state(shared_state.get("sensors", {}), shared_state.get("actuators", {}))
            except Exception:
                pass

            try:
                _publish_registers_to_shared(shared_state, _CURRENT_TIPICO)
            except Exception:
                pass

        except Exception as exc:  # pragma: no cover - protección en runtime
            print(f"[modbus] Error en ciclo Modbus: {exc}")

        time.sleep(poll_seconds)
